\set ON_ERROR_STOP on
\o /dev/null

select pg_has_role(session_user, 'postgres', 'MEMBER') as c3_has_membership
\gset
\if :c3_has_membership
\else
  \o
  \echo role_assumption_missing
  \quit 0
\endif

select current_role = 'postgres' as c3_role_applied
\gset
\if :c3_role_applied
\else
  \o
  \echo role_assumption_not_applied
  \quit 0
\endif

select
  has_table_privilege(current_user, 'public.transaction', 'SELECT')
  and has_table_privilege(current_user, 'public.cas_import', 'SELECT')
  and has_table_privilege(current_user, 'public.user_fund', 'SELECT')
  as c3_has_table_authority
\gset
\if :c3_has_table_authority
\else
  \o
  \echo table_authority_missing
  \quit 0
\endif

select has_function_privilege(
  current_user,
  'public.resolve_user_fund_activation_v1(boolean,boolean,jsonb,boolean,boolean)',
  'EXECUTE'
) as c3_has_resolver_authority
\gset
\if :c3_has_resolver_authority
\else
  \o
  \echo resolver_authority_missing
  \quit 0
\endif

select 1 / ((
  transaction_scope.row_count = 0
  and import_scope.row_count = 0
  and holding_scope.row_count = 0
  and public.resolve_user_fund_activation_v1(
    false,
    null,
    'null'::jsonb,
    true,
    false
  ) is false
)::integer)
from (select count(*) as row_count from public.transaction where false) as transaction_scope,
     (select count(*) as row_count from public.cas_import where false) as import_scope,
     (select count(*) as row_count from public.user_fund where false) as holding_scope;

select 1 / (length(encode(extensions.digest('', 'sha256'), 'hex')) / 64);

\o
\echo ready
